{
  "name": "takiply",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run lint && npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "android:aab": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "mobile:sync": "npm run build && npx cap sync",
