    "mobile:ios": "node scripts/ensure-ios-supported.mjs && npm run build && npx cap run ios"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.1.0",
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
